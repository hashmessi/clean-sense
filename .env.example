# CleanSense Lite -- API keys for the LLM planner.
# Copy this file to .env (same folder) and fill in the values you have.
# Never commit .env. Leave a provider blank to skip it.

# Primary planner provider: anthropic | gemini | openrouter
LLM_PROVIDER=anthropic

# Anthropic (current default wiring in planner_llm.py)
ANTHROPIC_API_KEY=

# Google Gemini (generativelanguage.googleapis.com) -- free-tier Flash/Flash-Lite models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter -- pin ONE specific :free vision model, not the random free router,
# so results stay reproducible run to run.
OPENROUTER_API_KEY=
# Pinned from OpenRouter's free list. UNVERIFIED: image input and json_schema support are
# not yet confirmed live. Run check_providers.py before the demo. Never use openrouter/free here.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional override of the Anthropic model (existing env var already read by planner_llm.py)
CLEANSENSE_MODEL=

# Spoken announcements (optional). Piper is an open-source offline TTS. Leave PIPER_VOICE empty to stay silent.
# PIPER_VOICE is the path to a Piper voice model (.onnx); PIPER_CMD is the piper command (default: piper).
# UNVERIFIED on this machine: check the Piper release and voice licence on the PC before the demo.
PIPER_CMD=piper
PIPER_VOICE=
